+//  CHECK-DAG: #[[TRANSLATION:.+]] = #iree_codegen.translation_info<pipeline = #iree_gpu.spirv_pipeline<SubgroupReduce> workgroup_size = [32, 1, 1] subgroup_size = 32>
+//      CHECK: func.func @subgroup_reduce_variable_width_dynamic(
